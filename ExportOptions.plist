<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shared by the iOS and macOS App Store exports.
	     On Xcode older than 15.3, change "app-store-connect" to "app-store". -->
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>export</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<!-- Optional: uncomment and fill in if xcodebuild can't infer your team.
	<key>teamID</key>
	<string>YOUR10CHARS</string>
	-->
</dict>
</plist>
