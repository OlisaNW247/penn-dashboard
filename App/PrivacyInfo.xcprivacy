<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- LHF runs on-device by default and contains no analytics, tracking,
	     or advertising SDKs. Two things leave the device beyond talking to
	     Canvas/Gradescope: a small, identifier-free update-manifest check
	     against a host the maintainer controls (see
	     LowHangingFruitKit/Sources/LowHangingFruitKit/Update/), and, only
	     if the student pastes in their own Anthropic API key, two opt-in
	     AI features (Announcement Watcher assist, ask/"the tree") that
	     send class data to Anthropic's API. There is still no LHF server
	     or account. See docs/PRIVACY.md. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!-- The app stores the user's name, captured Canvas calendar-feed URL,
		     completed/edited items, reminder preferences, self-created tasks,
		     grade settings (category weights, confirmed matches, an attached
		     syllabus's grading scheme) and observed grade history in
		     UserDefaults. Live session cookies go to the Keychain instead
		     (SessionCookieStore), never here. This data is only ever read by
		     this app and its widget. -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
		<!-- WidgetSnapshotStore writes the "next due" snapshot into the shared
		     App Group container for the widget to read. -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
